[global]
    monitor = 0
    follow = mouse
    width = (320, 440)
    height = (0, 320)
    origin = top-right
    offset = (16, 64)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 360
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    transparency = 8
    separator_height = 4
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 2
    frame_color = "#00ff9c"
    gap_size = 8
    separator_color = frame
    sort = yes
    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span foreground='#7b8a84'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 40
    max_icon_size = 56
    icon_corner_radius = 12
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/wofi --dmenu
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 18
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#05070a"
    foreground = "#d8e3d4"
    frame_color = "#1b2330"
    highlight = "#00e5ff"
    timeout = 4

[urgency_normal]
    background = "#05070a"
    foreground = "#d8e3d4"
    frame_color = "#00ff9c"
    highlight = "#00ff9c"
    timeout = 6

[urgency_critical]
    background = "#15000a"
    foreground = "#ff7a9a"
    frame_color = "#ff003c"
    highlight = "#ff003c"
    timeout = 0
