{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 1,
        "width": 1,
        "padding": {
            "top": 2,
            "left": 1,
            "right": 2
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────Hardware────────┐"
        },
        {
            "type": "host",
            "key": "󰌢 PC  ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│├󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│├󰍹 GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│├󰑭 RAM",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "└└󰋊 Disk",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└─────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────Software──────┐"
        },
        {
            "type": "os",
            "key": "  OS  ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│├󰌽 Kern",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│├󰏗 Pkgs",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└└󰞷 Shell",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────Desktop───────┐"
        },
        {
            "type": "wm",
            "key": "  WM  ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│├󰆍 Term",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "└└󰔚 Up  ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└─────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
