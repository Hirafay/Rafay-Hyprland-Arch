{
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format":          "{icon}  <span>{capacity}%</span>",
    "format-full":     "󰁹  <span>100%</span>",
    "format-charging": "󱐋  <span>{capacity}%</span>",
    "format-plugged":  "󰚥  <span>AC</span>",
    "format-alt":      "{icon}  <span>{time}</span>",
    "tooltip-format": "{timeTo}\n\n󰠠 draw   {power:0.1f}W\n󱤅 health {health}%\n󱍸 cycles {cycles}",
    "format-icons": [
      "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
    ]
  }
}
