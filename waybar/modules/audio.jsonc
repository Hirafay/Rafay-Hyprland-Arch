{
  "pulseaudio": {
    "format": "{icon}  <span>{volume}%</span>",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone":  "󰋋",
      "headset":    "󰋋",
      "hands-free": "󰋋",
      "default":    ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "out {volume}%"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source":        "󰍬",
    "format-source-muted":  "󰍭"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  }
}
