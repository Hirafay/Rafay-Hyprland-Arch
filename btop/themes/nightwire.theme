#  NIGHTWIRE theme for btop — phosphor-void
#  Install: ~/.config/btop/themes/nightwire.theme
#  Then set in btop.conf:  color_theme = "nightwire"

theme[main_bg]="#05070a"
theme[main_fg]="#d8e3d4"
theme[title]="#d8e3d4"
theme[hi_fg]="#00ff9c"
theme[selected_bg]="#141b24"
theme[selected_fg]="#00ff9c"
theme[inactive_fg]="#4a5a52"
theme[graph_text]="#d8e3d4"
theme[meter_bg]="#0a0e14"
theme[proc_misc]="#00ff9c"

theme[cpu_box]="#00ff9c"
theme[mem_box]="#ff2975"
theme[net_box]="#00e5ff"
theme[proc_box]="#ffb000"
theme[div_line]="#1b2330"

theme[temp_start]="#00ff9c"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff003c"

theme[cpu_start]="#00ff9c"
theme[cpu_mid]="#4dffb8"
theme[cpu_end]="#00e5ff"

theme[free_start]="#00ff9c"
theme[free_mid]="#4dffb8"
theme[free_end]="#00e5ff"

theme[cached_start]="#00e5ff"
theme[cached_mid]="#66eeff"
theme[cached_end]="#00ff9c"

theme[available_start]="#00e5ff"
theme[available_mid]="#4dffb8"
theme[available_end]="#00ff9c"

theme[used_start]="#ffb000"
theme[used_mid]="#ff6ca3"
theme[used_end]="#ff003c"

theme[download_start]="#00e5ff"
theme[download_mid]="#66eeff"
theme[download_end]="#00ff9c"

theme[upload_start]="#ff2975"
theme[upload_mid]="#ff6ca3"
theme[upload_end]="#ff003c"

theme[process_start]="#00e5ff"
theme[process_mid]="#00ff9c"
theme[process_end]="#ffb000"
